manifest { name='ont-primer-bounded-blast'; nextflowVersion='>=24.10.0' }
params {
 demultiplex=true
 raw_fastq=null; raw_fastq_dir=null; sample_map=null; project_sample_map=null; all_gene_primers=null; amplicon_primers=null; assay_blast_db_map=null; taxonomy_db_dir=null
 demux_script=".../ont_demux_module_samplemap_only_optimized_rectified.py"; multiqc_config=".../modular_demux_blast_otus_nf/ont_modular_blast_nf/multiqc_config.yaml"; outdir='results'
 demux_chunk_reads=20000; blast_chunk_reads=10000
 control_regex='(?i)(^|[_-])(PK|NK)([_-]|$)'; demux_debug=false; demux_min_score_gap=2; demux_index_max_mismatches=1; demux_index_window=250; demux_primer_window=80; demux_max_open_writers=64
 cluster_otus=false; otu_identity=0.97; otu_max_seqlength=100000; primer_error_rate=0.1
 min_quality=10; min_length=300; max_length=6000
 blast_task='blastn'; blast_evalue='1e-20'; blast_max_target_seqs=1000; blast_min_pident=90; blast_min_align_len=300; blast_min_query_coverage=50
}
process {
 executor='local'; shell=['/bin/bash','-euo','pipefail']
 withLabel:process_low {cpus=2;memory=4.GB;time=4.h}
 withLabel:process_medium {cpus=2;memory=8.GB;time=24.h}
 withLabel:process_prepare_queries {cpus=2;memory=12.GB;time=24.h}
 withLabel:process_demux {cpus=1;memory=8.GB;time=24.h;maxForks=100}
 withLabel:process_blast_chunk {cpus=2;memory=20.GB;time=48.h;maxForks=100;errorStrategy = {task.exitStatus in [140] ? 'retry' : 'terminate'};maxRetries = 2}
 withLabel:process_blast_post {cpus=2;memory=12.GB;time=24.h;maxForks=20}
 withLabel:process_report {cpus=2;memory=8.GB;time=12.h}
}
profiles {
 standard {process.executor='local'}
 slurm_modules {
  process.executor='slurm'; docker.enabled=false; apptainer.enabled=false; singularity.enabled=false; conda.enabled=false
  process {
   withLabel:process_demux {beforeScript='module purge\nmodule load ont_demux_ampl'}
   withName:FILTER_READS {beforeScript='module purge\nmodule load chopper'}
   withName:PREPARE_QUERIES {beforeScript='module purge\nmodule load ont_demux_ampl\nmodule load vsearch'}
   withName:BLAST_CHUNK {beforeScript='module purge\nmodule load blast\nmodule load ont_demux_ampl'}
   withName:BLAST_CLASSIFY {beforeScript='module purge\nmodule load ont_demux_ampl'}
   withName:BLAST_FASTA {beforeScript='module purge\nmodule load blast'}
   withName:FASTQC {beforeScript='module purge\nmodule load ont_demux_ampl'}
   withName:SEQKIT_UNFILTERED {beforeScript='module purge\nmodule load ont_demux_ampl'}
   withName:SEQKIT_FILTERED {beforeScript='module purge\nmodule load ont_demux_ampl'}
   withName:MULTIQC_CUSTOMER {beforeScript='module purge\nmodule load ont_demux_ampl'}
   withName:KRONA_HTML {beforeScript='module purge\nmodule load ont_demux_ampl'}
   withLabel:process_report {beforeScript='module purge\nmodule load ont_demux_ampl'}
   withLabel:process_low {beforeScript='module purge\nmodule load ont_demux_ampl\nmodule load blast'}
  }
 }
}
trace {enabled=true;file="${params.outdir}/pipeline_trace.tsv";overwrite=true}
report {enabled=true;file="${params.outdir}/pipeline_report.html";overwrite=true}
timeline {enabled=true;file="${params.outdir}/pipeline_timeline.html";overwrite=true}
dag {enabled=true;file="${params.outdir}/pipeline_dag.html";overwrite=true}
